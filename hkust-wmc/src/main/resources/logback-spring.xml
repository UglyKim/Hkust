<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 控制台输出 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 自定义日志格式 -->
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %cyan(%thread) %logger{36} - %msg%n%rEx
            </pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件输出（可选） -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/wmc.log</file>
        <encoder>
            <!-- 自定义日志格式 -->
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n%rEx
            </pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 根日志配置 -->
    <root level="info">
        <appender-ref ref="STDOUT" />
        <!-- 如果需要文件输出，可以添加以下行 -->
        <!-- <appender-ref ref="FILE" /> -->
    </root>

</configuration>